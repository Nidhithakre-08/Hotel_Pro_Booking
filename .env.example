# Copy this file to .env and fill in your own values. Never commit .env.

# Local development can use the JSON file when MongoDB is unset/unreachable.
# Vercel requires a valid MongoDB connection; data is never stored in serverless memory.
MONGODB_URI=
MONGODB_DB=hotelpro

# Required for production: a random secret, at least 32 characters
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Admin login (used ONLY at /admin). Production password must be at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# WhatsApp button + chatbot support details (used by the website). Country code + number, digits only.
VITE_WHATSAPP_NUMBER=919876543210
VITE_SUPPORT_PHONE=+91 98765 43210
VITE_SUPPORT_EMAIL=hello@hotelpro.com
